# JS, CSS, HTML, XML은 LF로 통일
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.xml     text eol=lf

# Shell script, Markdown 등도 LF
*.sh      text eol=lf
*.md      text eol=lf

# Windows 환경에서만 CRLF 필요할 경우
# *.bat     text eol=crlf

# 바이너리 파일은 줄바꿈 변환하지 않음
*.png     binary
*.jpg     binary
*.gif     binary
*.woff    binary
*.woff2   binary